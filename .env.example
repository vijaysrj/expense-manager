# Postgres connection string. On Vercel, adding a Neon database from the
# Marketplace (Storage tab) sets this for you.
DATABASE_URL=

# Your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# (ANTHROPIC_KEY also works.)

# Optional: model used to understand messages. Defaults to claude-opus-5-5.
# claude-haiku-5-5 is far cheaper and is usually good enough for logging.
# ANTHROPIC_MODEL=claude-opus-5-5

# Passcode you type to sign in.
APP_PASSWORD=

# Long random string used to sign the login cookie, e.g. `openssl rand -hex 32`.
AUTH_SECRET=

# Optional: timezone used to resolve "today" / "yesterday", and the currency.
# APP_TIMEZONE=Asia/Kolkata
# APP_CURRENCY=INR
